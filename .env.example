# Google Gemini API Key: Required for server-side AI chat, tool calling and image analysis
# Configured via AI Studio Secrets or directly in .env
GEMINI_API_KEY=

# Kilo AI Gateway (OpenAI Compatible)
# Docs: https://kilo.ai/docs/gateway
# Chave de API do Kilo Gateway
KILO_API_KEY=

# Modelo a ser utilizado no Gateway Kilo (armazenado em secret)
# Exemplos: anthropic/claude-3-5-sonnet, openai/gpt-4o, google/gemini-2.5-flash, deepseek/deepseek-chat
KILO_MODEL=

# Base URL do Kilo Gateway (padrão: https://api.kilo.ai/api/gateway)
KILO_BASE_URL=https://api.kilo.ai/api/gateway

# Provedor preferencial de IA: "kilo" ou "gemini" (opcional, detectado automaticamente)
AI_PROVIDER=

# Optional alternative API key variable name
API_KEY=

# Session secret for express-session
SESSION_SECRET=

# Path to the SQLite database file (optional, defaults to database.sqlite in root)
DB_PATH=

# APP_URL: The URL where this applet is hosted (injected by AI Studio)
APP_URL=

# Control visibility of AI execution steps in chat (default: false)
VITE_SHOW_AI_STEPS=false

