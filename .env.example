# ==============================================================================
# Cronos TimeTracker — Environment Configuration
# ==============================================================================

# Application
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_URL=https://cronoscron.duckdns.org

# Database (PostgreSQL)
DB_DIALECT=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cronos

# Redis
REDIS_URL=redis://redis:6379

# Session & Authentication
SESSION_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_SECRET=change-this-to-another-secure-random-string-min-32-chars

# Sentry (Error Monitoring) — Get from sentry.io
SENTRY_DSN=

# Resend (Email) — Get from resend.com
RESEND_API_KEY=
RESEND_FROM=Cronos App <onboarding@resend.dev>

# Stripe (Payments) — Get from stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_TEAM=price_...

# AI (Kilo Gateway or Gemini)
AI_PROVIDER=kilo
KILO_API_KEY=
KILO_MODEL=stepfun/step-3.7-flash:free
KILO_BASE_URL=https://api.kilo.ai/api/gateway
GEMINI_API_KEY=

# Git Integration (GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Backup
BACKUP_DIR=/var/backups/cronos
RETENTION_DAYS=30
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cronos
DB_USER=postgres
POSTGRES_PASSWORD=postgres
